\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Feature importance for the Gradient Boosting synergy classifier.} Top 20 features ranked by Gini importance from a model trained on the full dataset (all 45 combinations, not cross-validated; CV-based importance estimates are unstable at $n = 45$). Pathway identity (ribosome) and FBA flux perturbation metrics are the strongest predictors. Feature categories: blue = pathway identity, green = FBA metabolic features, orange = gene essentiality, gray = other.}}{12}{figure.4}\protected@file@percent }
\newlabel{fig:feature_importance}{{4}{12}{\textbf {Feature importance for the Gradient Boosting synergy classifier.} Top 20 features ranked by Gini importance from a model trained on the full dataset (all 45 combinations, not cross-validated; CV-based importance estimates are unstable at $n = 45$). Pathway identity (ribosome) and FBA flux perturbation metrics are the strongest predictors. Feature categories: blue = pathway identity, green = FBA metabolic features, orange = gene essentiality, gray = other}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}FBA as Feature Generator, Not Synergy Calculator}{12}{subsection.4.2}\protected@file@percent }
\citation{bollenbach2009}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Predicted vs.\ observed Bliss independence scores (GroupKFold CV).} Gradient Boosting regression ($R^2 = 0.594$, Pearson $r = 0.772$) on 45 curated antibiotic combinations. Points are colored by interaction class: synergistic (blue), antagonistic (red), additive (gray). The dashed line indicates perfect prediction. Note reduced $R^2$ compared to stratified CV (0.718) due to gene-level splitting that prevents leakage from shared target genes.}}{13}{figure.5}\protected@file@percent }
\newlabel{fig:regression}{{5}{13}{\textbf {Predicted vs.\ observed Bliss independence scores (GroupKFold CV).} Gradient Boosting regression ($R^2 = 0.594$, Pearson $r = 0.772$) on 45 curated antibiotic combinations. Points are colored by interaction class: synergistic (blue), antagonistic (red), additive (gray). The dashed line indicates perfect prediction. Note reduced $R^2$ compared to stratified CV (0.718) due to gene-level splitting that prevents leakage from shared target genes}{figure.5}{}}
