\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {ML model performance for synergy prediction.} Primary metrics reported under gene-level GroupKFold (5 folds) to prevent data leakage from shared target genes. Stratified 5-fold results shown in parentheses for comparison.}}{8}{table.2}\protected@file@percent }
\newlabel{tab:ml_results}{{2}{8}{\textbf {ML model performance for synergy prediction.} Primary metrics reported under gene-level GroupKFold (5 folds) to prevent data leakage from shared target genes. Stratified 5-fold results shown in parentheses for comparison}{table.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}ML Classification Performance}{8}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Pathway-level interaction heatmap for curated antibiotic combinations.} (A) Number of curated combinations per pathway pair. (B) Mean Bliss synergy score per pathway pair. Ribosome-targeting combinations show a mixed profile: enriched for antagonism (8/10 antagonistic pairs) rather than synergy (6/28 synergistic pairs). LPS + transcription pairs show the strongest synergy enrichment.}}{9}{figure.2}\protected@file@percent }
\newlabel{fig:heatmap}{{2}{9}{\textbf {Pathway-level interaction heatmap for curated antibiotic combinations.} (A) Number of curated combinations per pathway pair. (B) Mean Bliss synergy score per pathway pair. Ribosome-targeting combinations show a mixed profile: enriched for antagonism (8/10 antagonistic pairs) rather than synergy (6/28 synergistic pairs). LPS + transcription pairs show the strongest synergy enrichment}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Feature ablation study.} Reported under stratified 5-fold CV for consistency with ablation comparisons (GroupKFold ablation is not shown because gene-group structure varies across feature subsets). Pathway features include one-hot pathway encoding; FBA features include flux changes, reaction counts, essentiality scores, subsystem disruption. Primary full-model results use GroupKFold (Table~\ref {tab:ml_results}).}}{9}{table.3}\protected@file@percent }
\newlabel{tab:ablation}{{3}{9}{\textbf {Feature ablation study.} Reported under stratified 5-fold CV for consistency with ablation comparisons (GroupKFold ablation is not shown because gene-group structure varies across feature subsets). Pathway features include one-hot pathway encoding; FBA features include flux changes, reaction counts, essentiality scores, subsystem disruption. Primary full-model results use GroupKFold (Table~\ref {tab:ml_results})}{table.3}{}}
\@writefile{toc}{\contentsline {paragraph}{Feature ablation.}{9}{section*.1}\protected@file@percent }
\citation{bollenbach2009}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {ML synergy prediction under gene-level GroupKFold CV.} (A) ROC curves for binary classification (synergistic vs.\ rest) under GroupKFold. Gradient Boosting achieves AUROC = 0.804, Random Forest AUROC = 0.742. (B) Confusion matrix for Gradient Boosting binary classifier (GroupKFold F1 = 0.847). (C) Permutation test under GroupKFold: observed F1 = 0.847 (red line) compared to 1,000 permutations of shuffled labels (gray histogram); $z$ = 2.58, $p < 0.001$.}}{10}{figure.3}\protected@file@percent }
\newlabel{fig:ml_performance}{{3}{10}{\textbf {ML synergy prediction under gene-level GroupKFold CV.} (A) ROC curves for binary classification (synergistic vs.\ rest) under GroupKFold. Gradient Boosting achieves AUROC = 0.804, Random Forest AUROC = 0.742. (B) Confusion matrix for Gradient Boosting binary classifier (GroupKFold F1 = 0.847). (C) Permutation test under GroupKFold: observed F1 = 0.847 (red line) compared to 1,000 permutations of shuffled labels (gray histogram); $z$ = 2.58, $p < 0.001$}{figure.3}{}}
