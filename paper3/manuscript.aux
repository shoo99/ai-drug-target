\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}BDNF Direction Is Not Universally Downward}{6}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {BDNF direction in hippocampus is not consistently downward.} (A) Temporal trend showing reversal from decrease-dominant (2010--2014) to increase-dominant (2020--2026). (B) Stress-type comparison: early-life stress favors decrease; acute and chronic stress show near-equal or increase-favoring patterns.}}{7}{figure.1}\protected@file@percent }
\newlabel{fig:bdnf}{{1}{7}{\textbf {BDNF direction in hippocampus is not consistently downward.} (A) Temporal trend showing reversal from decrease-dominant (2010--2014) to increase-dominant (2020--2026). (B) Stress-type comparison: early-life stress favors decrease; acute and chronic stress show near-equal or increase-favoring patterns}{figure.1}{}}
