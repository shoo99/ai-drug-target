\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Metric-separated brain region effects.} (A) Structural metrics: most regions show decrease. (B) Functional metrics: amygdala and several cortical regions show increase. The divergence between structural and functional patterns resolves apparent contradictions in the literature.}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:metric}{{3}{9}{\textbf {Metric-separated brain region effects.} (A) Structural metrics: most regions show decrease. (B) Functional metrics: amygdala and several cortical regions show increase. The divergence between structural and functional patterns resolves apparent contradictions in the literature}{figure.3}{}}
